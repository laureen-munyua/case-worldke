generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PhoneCase {
  id        Int      @id @default(autoincrement())
  name      String
  price     Float
  brand     String
  material  String
  color     String
  image     String
  createdAt DateTime @default(now())
}